{
  "name": "Daling",
  "webRoot": "web",
  "workDir": ".design-studio",
  "context": "context.md",
  "client": "studio.app.js",
  "checks": [
    "node --check {web}/app.js"
  ],
  "modes": {
    "demo": {
      "launch": [
        "{venv_python}",
        "-X",
        "utf8",
        "{config_dir}/run_demo.py",
        "--project",
        "{project}",
        "--port",
        "{port}"
      ],
      "requests": {
        "pass": [
          "POST /api/selection",
          "POST /api/timetable/save",
          "POST /api/timetable/delete",
          "POST /api/timetable/bulk",
          "POST /api/my-events/save",
          "POST /api/my-events/delete",
          "POST /api/ui-prefs",
          "POST /api/tutorial/done",
          "POST /api/whats-new/seen",
          "POST /api/shelves/save"
        ],
        "mock": {
          "GET /api/notices": {
            "ok": true,
            "items": []
          },
          "GET /api/seminars": {
            "ok": true,
            "items": []
          },
          "GET /api/school-events": {
            "ok": true,
            "items": []
          },
          "GET /api/dgist-api/status": {
            "ok": true,
            "hasKey": false
          },
          "GET /api/shuttle": {
            "ok": true,
            "routes": []
          },
          "GET /api/place-search": {
            "ok": true,
            "places": []
          },
          "GET /api/fglp": {
            "ok": true,
            "schools": []
          },
          "GET /api/directory": {
            "ok": true,
            "results": []
          },
          "GET /api/mail/folders": {
            "ok": true,
            "folders": [
              {
                "key": "inbox",
                "name": "받은편지함"
              },
              {
                "key": "sent",
                "name": "보낸편지함"
              },
              {
                "key": "trash",
                "name": "휴지통"
              }
            ]
          },
          "GET /api/samsung-notes/status": {
            "ok": true,
            "available": true
          },
          "GET /api/window": {
            "ok": true
          },
          "GET /api/drive/list": {
            "ok": true,
            "files": []
          }
        }
      }
    },
    "real": {
      "launch": [
        "{venv_python}",
        "-X",
        "utf8",
        "{config_dir}/run_demo.py",
        "--project",
        "{project}",
        "--port",
        "{port}",
        "--real"
      ]
    }
  },
  "requests": {
    "deny": [
      "GET /api/mail/eml"
    ]
  }
}
